<Window x:Class="Vento.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="Height" Width="340"
        WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Loaded="OnLoaded" Deactivated="OnDeactivated" PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#8A97B4"/>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>

        <!-- Botón de modo; Tag="sel" lo marca como activo -->
        <Style x:Key="ModeButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="12,10"
                                Background="#1AFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="sel">
                                <Setter TargetName="Bd" Property="Background" Value="#0EA5E9"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0EA5E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Margin="14" Padding="18,16"
            Background="#F7161D2B" BorderBrush="#26FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <StackPanel>
            <Grid Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown">
                <TextBlock Text="Vento" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#EF4444" Margin="0,0,6,0"/>
                    <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource Muted}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="SENSACIÓN TÉRMICA" Style="{StaticResource Label}" Margin="0,16,0,0"/>
            <TextBlock x:Name="HicText" Text="--°" FontSize="38" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="SubText" Text="-- °C · -- %" FontSize="13" Foreground="{StaticResource Muted}"/>

            <TextBlock Text="MODO AUTOMÁTICO" Style="{StaticResource Label}" Margin="0,18,0,8"/>
            <UniformGrid Columns="2">
                <Button x:Name="AutoButton" Style="{StaticResource ModeButton}" Margin="0,0,4,0" Click="OnAuto">
                    <StackPanel>
                        <TextBlock Text="Auto" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="Máximo al superar el objetivo" FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ProgressiveButton" Style="{StaticResource ModeButton}" Margin="4,0,0,0" Click="OnProgressive">
                    <StackPanel>
                        <TextBlock Text="Progresivo" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="Más rápido cuanto más calor" FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <Grid Margin="0,18,0,0">
                <TextBlock Text="TEMPERATURA OBJETIVO" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                <TextBlock x:Name="SetpointText" Text="--°" HorizontalAlignment="Right"
                           FontSize="20" FontWeight="SemiBold" Foreground="White"/>
            </Grid>
            <Slider x:Name="SetpointSlider" Minimum="16" Maximum="70" TickFrequency="3"
                    IsSnapToTickEnabled="True" Margin="0,8,0,0" ValueChanged="OnSetpointChanged"/>

            <Grid Margin="0,14,0,0">
                <TextBlock x:Name="ModeText" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <Button Content="Apagar" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Click="OnOff"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
