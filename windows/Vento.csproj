<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Vento</AssemblyName>
    <RootNamespace>Vento</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>vento.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <AssemblyTitle>Vento</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vento.Tests" />
    <EmbeddedResource Include="vento.ico" LogicalName="vento.ico" />
  </ItemGroup>

</Project>
